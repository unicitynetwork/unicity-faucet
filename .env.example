# Unicity Faucet Environment Configuration
# Copy this file to .env and update the values

# API key for accessing faucet history
# Generate a strong random key for production
FAUCET_API_KEY=your-secret-api-key-here

# BIP-39 mnemonic phrase for faucet wallet
# IMPORTANT: Generate a new mnemonic for production!
# This is the faucet's private key - keep it secure!
FAUCET_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# How many days of per-request token JSON files to keep under data/tokens/.
# Files are written into daily shards (tokens/yyyy-MM-dd/) and a daily sweep
# prunes shards older than this. Set to 0 to disable pruning. Default: 7
FAUCET_TOKEN_RETENTION_DAYS=7
